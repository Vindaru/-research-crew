# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=            # free key at https://app.tavily.com
# Safety: the run stops once it has spent this many US dollars (agents + judge). Live tests also need RUN_LIVE_TESTS=1.
RESEARCH_CREW_MAX_USD=1.00
# Optional: tracing. Leave blank to run without Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
